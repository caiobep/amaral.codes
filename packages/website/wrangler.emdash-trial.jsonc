{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amaral-website-emdash-trial",
  "workers_dev": true,
  "main": "./src/worker/emdash.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amaral-website-emdash-trial-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "amaral-website-emdash-trial-media"
    }
  ]
}
