{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amaral-website-preview",
  "workers_dev": false,
  "preview_urls": false,
  "main": "./src/worker/emdash.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amaral-website-preview-db",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "amaral-website-preview-media",
    },
  ],
}
