{
  "name": "@amaral.codes/website",
  "type": "module",
  "version": "0.0.1",
  "author": "Caio Amaral Correa <caiobep@me.com>",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build --force",
    "build:production-content": "AMARAL_CONTENT_SOURCE=production npm run build",
    "postbuild": "node scripts/commands/generate-service-worker.mjs && node scripts/commands/validate-pwa.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run quality",
    "test:static": "npm run test:static:typescript && npm run test:static:eslint",
    "test:static:typescript": "astro sync --force && tsc --noEmit",
    "test:static:eslint": "eslint --max-warnings 0 --ext .astro,.js,.jsx,.mjs,.ts,.tsx src scripts tests playwright.config.mjs vitest.config.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "playwright test --tsconfig tests/browser/tsconfig.json",
    "test:browser:local": "AMARAL_CONTENT_SOURCE=fixtures npm run build && npm run test:browser",
    "verify:assets": "node scripts/commands/check-static-assets.mjs && node scripts/commands/check-content-assets.mjs --remote",
    "test:coverage": "vitest run --coverage",
    "perf": "npm run build && npm run perf:measure",
    "perf:measure": "node scripts/commands/measure-performance.mjs",
    "perf:ci": "node scripts/commands/measure-performance.mjs --assert --runs=3",
    "perf:desktop": "node scripts/commands/measure-performance.mjs --assert --runs=3 --preset=desktop",
    "perf:field": "node scripts/commands/measure-pagespeed.mjs",
    "quality": "npm run quality:files && npm run quality:assets && npm run test:static && npm run test:coverage && npm run quality:crap",
    "quality:assets": "node scripts/commands/check-static-assets.mjs",
    "quality:files": "node scripts/commands/check-source-size.mjs",
    "quality:crap": "npm run quality:crap:analyze && npm run quality:crap:assert",
    "quality:crap:analyze": "node scripts/commands/run-crap-analysis.mjs",
    "quality:crap:assert": "node ../../scripts/commands/assert-crap-report.mjs coverage/crap.json"
  },
  "dependencies": {
    "@amaral.codes/content-contract": "0.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "~1.26.0",
    "astro": "^7.1.0",
    "fuse.js": "^7.5.0",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "^0.4.2",
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^4.1.10",
    "chrome-launcher": "^1.2.1",
    "happy-dom": "^20.14.0",
    "js-yaml": "^4.1.0",
    "lighthouse": "~13.4.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
