{
  "name": "@amaral.codes/website",
  "type": "module",
  "version": "0.0.1",
  "author": "Caio Amaral Correa <caiobep@me.com>",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "build:production-content": "AMARAL_CONTENT_SOURCE=production npm run build",
    "postbuild": "node scripts/commands/generate-service-worker.mjs && node scripts/commands/validate-pwa.mjs",
    "preview": "astro preview",
    "lint": "eslint --max-warnings 0 --ext .astro,.js,.jsx,.mjs,.ts,.tsx src scripts tests playwright.config.mjs vitest.config.ts",
    "typecheck": "astro sync --force && astro check && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test --tsconfig tests/browser/tsconfig.json",
    "verify:assets": "node scripts/commands/check-static-assets.mjs && node scripts/commands/check-content-assets.mjs --remote",
    "perf": "node scripts/commands/measure-performance.mjs",
    "quality:crap": "node scripts/commands/run-crap-analysis.mjs && node ../../scripts/commands/assert-crap-report.mjs coverage/crap.json",
    "quality": "node scripts/commands/check-source-size.mjs && node scripts/commands/check-static-assets.mjs && npm run typecheck && npm run lint && npm test -- --coverage && npm run quality:crap",
    "dev:cms": "AMARAL_CMS_TRIAL=1 astro dev --host 127.0.0.1 --port 4323",
    "build:cms": "AMARAL_CMS_TRIAL=1 astro build --force",
    "build:cms:preview": "AMARAL_CONTENT_SOURCE=production AMARAL_CMS_PREVIEW=1 astro build --force",
    "preview:cms": "wrangler dev --local --config dist/server/wrangler.json --persist-to .wrangler/state --ip 127.0.0.1 --port 8789 --test-scheduled"
  },
  "dependencies": {
    "@amaral.codes/content-contract": "0.0.0",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@emdash-cms/admin": "^1.2.0",
    "@emdash-cms/auth": "1.2.0",
    "@emdash-cms/cloudflare": "1.2.0",
    "@lucide/astro": "~1.26.0",
    "astro": "7.3.8",
    "emdash": "1.2.0",
    "fuse.js": "^7.5.0",
    "mdast-util-from-markdown": "~2.0.3",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "~2.17.6",
    "shiki": "4.5.0",
    "srcset": "^5.0.3",
    "htmlparser2": "12.0.0",
    "sharp": "0.35.5",
    "@astrojs/markdown-satteri": "0.4.3"
  },
  "emdash": {
    "label": "Caio Amaral",
    "seed": "seed/emdash-trial.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "wrangler": "4.149.0"
  }
}
