---
import '../styles/global/fonts.css'
import '../styles/global/theme.css'
import '../styles/global/base.css'
import '../styles/global/ambient-light.css'
import '../styles/global/motion.css'
import '../features/search/header-search.css'
import Footer from '../components/Footer.astro'
import { createAppearanceBootstrapScript } from '../features/appearance/first-paint.client'
import HeaderSearch from '../features/search/HeaderSearch.astro'
import { createArticleStructuredData } from '../lib/structured-data'
import { createCanonicalUrl, requireSite } from '../lib/site'

export interface Props {
  class?: string
  title?: string
  description?: string
  sharingTitle?: string | undefined
  sharingDescription?: string | undefined
  image?: string
  imageAlt?: string
  imageHeight?: number | undefined
  imageType?: string | undefined
  imageWidth?: number | undefined
  language?: 'en' | 'pt-BR'
  languageAlternates?: readonly { language: 'en' | 'pt-BR', href: string }[]
  ogType?: 'article' | 'website'
  publishedTime?: string
  twitterCard?: 'summary' | 'summary_large_image'
  activeNav?: 'home' | 'posts' | 'projects' | 'about' | 'contact'
  swipePreviousHref?: string
  robots?: string
  footerFlush?: boolean
  hideFooter?: boolean
  structuredData?: Record<string, unknown> | undefined
  markdownAlternate?: string | undefined
  cmsContent?: { collection: string, id: string, slug?: string } | undefined
}

const {
  title = 'Caio Amaral',
  description = 'Caio Amaral writes about software, interfaces, productivity, media, and useful digital tools.',
  sharingTitle,
  sharingDescription,
  image = '/photos/profile/home-portrait-900.webp',
  imageAlt = 'Portrait of Caio Amaral',
  imageHeight = image === '/photos/profile/home-portrait-900.webp' ? 1125 : undefined,
  imageType = image === '/photos/profile/home-portrait-900.webp' ? 'image/webp' : undefined,
  imageWidth = image === '/photos/profile/home-portrait-900.webp' ? 900 : undefined,
  language = 'en',
  languageAlternates = [],
  ogType = 'website',
  publishedTime,
  twitterCard = 'summary',
  activeNav: activeNavOverride,
  swipePreviousHref,
  robots = 'index,follow',
  footerFlush = false,
  hideFooter = false,
  structuredData,
  markdownAlternate,
  cmsContent,
  ...rest
} = Astro.props

const site = requireSite(Astro.site)
const authorUrl = new URL('/about/', site).toString()
const canonicalUrl = createCanonicalUrl(Astro.url.pathname, site)
const pageTitle = title === 'Caio Amaral' ? title : `${title} | Caio Amaral`
const socialImage = new URL(image, site).toString()
const openGraphLocale = language === 'pt-BR' ? 'pt_BR' : 'en_CA'
const currentPath = Astro.url.pathname
const defaultArticleData = ogType === 'article' && publishedTime
  ? createArticleStructuredData({
      datePublished: publishedTime,
      description,
      image: socialImage,
      language,
      pathname: Astro.url.pathname,
      title,
    }, site)
  : undefined
const pageStructuredData = structuredData ?? defaultArticleData
const serializedStructuredData = pageStructuredData
  ? JSON.stringify(pageStructuredData).replaceAll('<', '\\u003c')
  : undefined

const navItems = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'projects', href: '/projects', label: 'Projects' },
  { id: 'posts', href: '/posts', label: 'Notes' },
  { id: 'about', href: '/about', label: 'About' },
  { id: 'contact', href: '/contact', label: 'Contact' },
] as const

const inferredActiveNav = navItems.find((item) => (
  item.href === '/'
    ? currentPath === '/'
    : currentPath === item.href || currentPath.startsWith(`${item.href}/`)
))?.id

const activeNav = activeNavOverride ?? inferredActiveNav
const appearanceBootstrapScript = createAppearanceBootstrapScript()
const cmsUi = import.meta.env.AMARAL_CMS_TRIAL === '1' ? await import('emdash/ui') : undefined
const EmDashBodyStart = cmsUi?.EmDashBodyStart
const EmDashBodyEnd = cmsUi?.EmDashBodyEnd
const cmsPage = import.meta.env.AMARAL_CMS_TRIAL === '1'
  ? (await import('emdash/page')).createPublicPageContext({
      url: Astro.url,
      locale: language,
      kind: cmsContent ? 'content' : 'custom',
      title,
      ...(cmsContent ? { content: cmsContent } : {}),
      seo: { robots },
    })
  : undefined
---

<!DOCTYPE html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ffffff" data-theme-color />
    <script is:inline set:html={appearanceBootstrapScript}></script>
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Caio Amaral" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Caio Amaral" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="canonical" href={canonicalUrl} />
    {languageAlternates.map(alternate => <link rel="alternate" hreflang={alternate.language} href={new URL(alternate.href, site)} />)}
    <link rel="describedby" href="/llms.txt" />
    {markdownAlternate
      ? <link rel="alternate" type="text/markdown" href={markdownAlternate} />
      : null}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg?v=3" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png?v=3" />
    <link rel="mask-icon" href="/favicon.svg?v=3" color="#174b47" />
    <link rel="alternate" type="application/rss+xml" title="Caio Amaral RSS" href="/rss.xml" />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {activeNav === 'home'
      ? <link rel="preload" href="/fonts/newsreader-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
      : activeNav === 'about'
      ? (
          <link rel="preload" href="/fonts/fraunces-latin-500.woff2" as="font" type="font/woff2" crossorigin />
        )
      : (
          <>
            <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
            <link rel="preload" href="/fonts/instrument-serif-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
          </>
        )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Caio Amaral" />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:title" content={sharingTitle ?? pageTitle} />
    <meta property="og:description" content={sharingDescription ?? description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageType ? <meta property="og:image:type" content={imageType} /> : null}
    {imageWidth ? <meta property="og:image:width" content={String(imageWidth)} /> : null}
    {imageHeight ? <meta property="og:image:height" content={String(imageHeight)} /> : null}
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    {ogType === 'article' ? <meta property="article:author" content={authorUrl} /> : null}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:creator" content="@caicorre" />
    <meta name="twitter:title" content={sharingTitle ?? pageTitle} />
    <meta name="twitter:description" content={sharingDescription ?? description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {serializedStructuredData
      ? <script type="application/ld+json" set:html={serializedStructuredData}></script>
      : null}
    <title>{pageTitle}</title>
  </head>

  <body>
    {cmsPage && EmDashBodyStart ? <EmDashBodyStart page={cmsPage} /> : null}
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-header-slot">
      <header class="site-header">
        <div class="site-header-inner">
          <a href="/" class="brand" aria-label="Caio Amaral home">
            <span>Caio Amaral</span>
          </a>

          <nav class="site-nav" aria-label="Primary navigation">
            <ul>
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    data-nav-id={item.id === 'contact' ? undefined : item.id}
                    aria-current={item.id === activeNav ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="header-actions">
            <HeaderSearch current={currentPath.startsWith('/search')} />
          </div>
        </div>
      </header>
    </div>

    <main
      id="content"
      tabindex="-1"
      data-swipe-previous-href={swipePreviousHref}
      {...rest}
    >
      <div class="ambient-light" aria-hidden="true"></div>
      <slot />
    </main>

    {hideFooter ? null : <Footer flush={footerFlush} />}

    <script>
      import '../scripts/layout/index'
    </script>
    {cmsPage && EmDashBodyEnd ? <EmDashBodyEnd page={cmsPage} /> : null}
  </body>
</html>
