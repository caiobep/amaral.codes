---
import '../styles/global/fonts.css'
import '../styles/global/theme.css'
import '../styles/global/base.css'
import '../styles/global/motion.css'
import '../styles/global/header-search.css'
import Footer from '../components/Footer.astro'
import HeaderSearch from '../components/HeaderSearch.astro'
import { createArticleStructuredData } from '../lib/structured-data'
import { createCanonicalUrl, requireSite } from '../lib/site'

export interface Props {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  imageHeight?: number
  imageType?: string
  imageWidth?: number
  language?: 'en' | 'pt-BR'
  ogType?: 'article' | 'website'
  publishedTime?: string
  twitterCard?: 'summary' | 'summary_large_image'
  activeNav?: 'home' | 'posts' | 'projects' | 'about' | 'contact'
  swipePreviousHref?: string
  robots?: string
  footerFlush?: boolean
  hideFooter?: boolean
  structuredData?: Record<string, unknown>
  markdownAlternate?: string
}

const {
  title = 'Caio Amaral',
  description = 'Caio Amaral writes about software, interfaces, productivity, media, and useful digital tools.',
  image = '/photos/profile/home-portrait-900.webp',
  imageAlt = 'Portrait of Caio Amaral',
  imageHeight = 1125,
  imageType = 'image/webp',
  imageWidth = 900,
  language = 'en',
  ogType = 'website',
  publishedTime,
  twitterCard = 'summary',
  activeNav: activeNavOverride,
  swipePreviousHref,
  robots = 'index,follow',
  footerFlush = false,
  hideFooter = false,
  structuredData,
  markdownAlternate,
  ...rest
} = Astro.props

const site = requireSite(Astro.site)
const authorUrl = new URL('/about/', site).toString()
const canonicalUrl = createCanonicalUrl(Astro.url.pathname, site)
const pageTitle = title === 'Caio Amaral' ? title : `${title} | Caio Amaral`
const socialImage = new URL(image, site).toString()
const openGraphLocale = language === 'pt-BR' ? 'pt_BR' : 'en_CA'
const currentPath = Astro.url.pathname
const defaultArticleData = ogType === 'article' && publishedTime
  ? createArticleStructuredData({
      datePublished: publishedTime,
      description,
      image: socialImage,
      language,
      pathname: Astro.url.pathname,
      title,
    }, site)
  : undefined
const pageStructuredData = structuredData ?? defaultArticleData
const serializedStructuredData = pageStructuredData
  ? JSON.stringify(pageStructuredData).replaceAll('<', '\\u003c')
  : undefined

const navItems = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'projects', href: '/projects', label: 'Projects' },
  { id: 'posts', href: '/posts', label: 'Notes' },
  { id: 'about', href: '/about', label: 'About' },
  { id: 'contact', href: '/contact', label: 'Contact' },
] as const

const inferredActiveNav = navItems.find((item) => (
  item.href === '/'
    ? currentPath === '/'
    : currentPath === item.href || currentPath.startsWith(`${item.href}/`)
))?.id

const activeNav = activeNavOverride ?? inferredActiveNav
---

<!DOCTYPE html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ffffff" data-theme-color />
    <script is:inline>
      (() => {
        const root = document.documentElement
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        let storedTheme = null
        let storedPalette = null

        try {
          storedTheme = localStorage.getItem('amaral-theme')
          localStorage.removeItem('amaral-palette')
          storedPalette = sessionStorage.getItem('amaral-palette')
        } catch {
          // System preference remains available when storage is blocked.
        }

        const theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : prefersDark ? 'dark' : 'light'
        const palettes = [
          'ember',
          'cobalt',
          'graphite',
          'garnet',
          'ochre',
          'plum',
          'lagoon',
        ]
        const palette = palettes.includes(storedPalette)
          ? storedPalette
          : palettes[Math.floor(Math.random() * palettes.length)] ?? 'cobalt'

        try {
          sessionStorage.setItem('amaral-palette', palette)
        } catch {
          // The random palette still applies for the current page.
        }

        root.dataset.theme = theme
        root.dataset.palette = palette
        root.style.colorScheme = theme
        document.querySelector('[data-theme-color]')?.setAttribute(
          'content',
          theme === 'dark' ? '#0f1413' : '#ffffff',
        )
      })()
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Caio Amaral" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Caio Amaral" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="describedby" href="/llms.txt" />
    {markdownAlternate
      ? <link rel="alternate" type="text/markdown" href={markdownAlternate} />
      : null}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg?v=3" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png?v=3" />
    <link rel="mask-icon" href="/favicon.svg?v=3" color="#174b47" />
    <link rel="alternate" type="application/rss+xml" title="Caio Amaral RSS" href="/rss.xml" />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
    {currentPath === '/'
      ? (
          <>
            <link rel="preload" href="/fonts/literata-latin.woff2" as="font" type="font/woff2" crossorigin />
            <link rel="preload" href="/fonts/newsreader-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
          </>
        )
      : null}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Caio Amaral" />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    {ogType === 'article' ? <meta property="article:author" content={authorUrl} /> : null}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:creator" content="@caicorre" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {serializedStructuredData
      ? <script type="application/ld+json" set:html={serializedStructuredData}></script>
      : null}
    <title>{pageTitle}</title>
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-header-slot">
      <header class="site-header">
        <div class="site-header-inner">
          <a href="/" class="brand" aria-label="Caio Amaral home">
            <span>Caio Amaral</span>
          </a>

          <nav class="site-nav" aria-label="Primary navigation">
            <ul>
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    data-nav-id={item.id === 'contact' ? undefined : item.id}
                    aria-current={item.id === activeNav ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="header-actions">
            <HeaderSearch current={currentPath.startsWith('/search')} />
          </div>
        </div>
      </header>
    </div>

    <main
      id="content"
      tabindex="-1"
      data-swipe-previous-href={swipePreviousHref}
      {...rest}
    >
      <slot />
    </main>

    {hideFooter ? null : <Footer flush={footerFlush} />}

    <script>
      import '../scripts/layout/index'
    </script>
  </body>
</html>
