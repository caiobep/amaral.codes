---
export interface Props {
  src: string;
  href: string;
  alt: string;
  tone?: 'silhouette';
  visualScale?: number;
}

const { href, src, alt, tone, visualScale = 1 } = Astro.props;
const hoverScale = Number((visualScale * 1.045).toFixed(3));
const logoStyle = [
  `--logo-scale: ${visualScale}`,
  `--logo-hover-scale: ${hoverScale}`,
  tone === 'silhouette'
    ? '--logo-item-filter: var(--logo-silhouette-filter); --logo-item-hover-filter: var(--logo-silhouette-hover-filter)'
    : '',
].filter(Boolean).join('; ');
---

<a href={href}>
  <img src={src} alt={alt} style={logoStyle} loading="lazy" width="140" height="80" />
</a>
