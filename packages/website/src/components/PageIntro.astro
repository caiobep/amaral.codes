---
import Heading from './Heading.astro'

interface Props {
  eyebrow?: string
  title: string
  summary: string
  variant?: 'default' | 'compact'
}

const { eyebrow, title, summary, variant = 'default' } = Astro.props
---

<section class:list={['page-intro page-shell', `page-intro-${variant}`]} data-reveal data-stagger>
  <div>
    {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
    <Heading level={1}>{title}</Heading>
    <p>{summary}</p>
  </div>
</section>

<style>
  .page-intro {
    padding: clamp(4.25rem, 7vw, 6.25rem) 0 clamp(3.25rem, 5vw, 4.5rem);
  }

  .eyebrow {
    margin-bottom: 0.75rem;
  }

  .page-intro :global(.heading) {
    max-width: 24ch;
  }

  div > p:not(.eyebrow) {
    max-width: 42rem;
    margin: 1.3rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .page-intro-compact {
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  @media (max-width: 680px) {
    .page-intro {
      padding-top: 2.75rem;
    }

    .page-intro-compact {
      padding-top: 2rem;
      padding-bottom: 1.35rem;
    }

    .page-intro-compact div > p {
      margin-top: 0.75rem;
    }
  }
</style>
