---
import {
  ArrowUpRight,
  CirclePlay,
  Cloud,
  ExternalLink,
  Headphones,
  Podcast,
  Radio,
} from '@lucide/astro'
import type { EntryData } from '../content/schemas'
import { resolvePublicAssetUrl } from '../lib/assets'

interface Props {
  podcast: NonNullable<EntryData['podcast']>
}

const { podcast } = Astro.props
const audioUrl = podcast.audioUrl ? resolvePublicAssetUrl(podcast.audioUrl) : undefined
const episodeLabel = podcast.episode
  ? `${podcast.show} · ${podcast.episode}`
  : podcast.show
const playerLabels = {
  applePodcasts: 'Apple Podcasts',
  spotify: 'Spotify',
  pocketCasts: 'Pocket Casts',
  overcast: 'Overcast',
} as const
---

<section class="podcast-player" aria-label="Listen to this podcast episode">
  <div class="podcast-heading">
    <Headphones aria-hidden="true" />
    <div>
      <span>Podcast appearance</span>
      <p>{episodeLabel}</p>
    </div>
  </div>

  {audioUrl
    ? (
      <>
        <audio controls preload="none" src={audioUrl}>
          <a href={audioUrl}>Download the episode audio</a>
        </audio>
        <p class="transcript-note">No transcript is available on this site.</p>
      </>
      )
    : (
      <p class="publisher-note">Listen through the original publisher.</p>
      )}

  <div class="listen-elsewhere">
    <span class="listen-label">Listen in</span>
    <ul class="player-links">
      {podcast.players.map((player) => (
        <li>
          <a
            href={player.url}
            target="_blank"
            rel="noreferrer"
            aria-label={`Listen on ${playerLabels[player.service]}`}
          >
            {player.service === 'applePodcasts' ? <Podcast aria-hidden="true" /> : null}
            {player.service === 'spotify' ? <CirclePlay aria-hidden="true" /> : null}
            {player.service === 'pocketCasts' ? <Radio aria-hidden="true" /> : null}
            {player.service === 'overcast' ? <Cloud aria-hidden="true" /> : null}
            <span>{playerLabels[player.service]}</span>
            <ArrowUpRight class="external-arrow" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="podcast-links">
    <a href={podcast.sourceUrl} target="_blank" rel="noreferrer">
      Episode notes
      <ExternalLink aria-hidden="true" />
    </a>
  </div>
</section>

<style>
  .podcast-player {
    display: grid;
    width: min(100%, 740px);
    gap: 1rem;
    margin: clamp(1.75rem, 3vw, 2.5rem) auto 0;
    border-bottom: 1px solid var(--line);
    padding: 0 0 1.25rem;
  }

  .podcast-heading {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .podcast-heading :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
    flex: 0 0 auto;
    color: var(--accent-strong);
    stroke-width: 1.7;
  }

  .podcast-heading span {
    color: var(--accent-strong);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .podcast-heading p,
  .publisher-note,
  .transcript-note {
    margin: 0.2rem 0 0;
    color: var(--muted);
    line-height: 1.5;
  }

  .transcript-note {
    margin-top: -0.35rem;
    font-size: 0.82rem;
  }

  audio {
    width: 100%;
    height: 3.25rem;
  }

  .listen-elsewhere {
    display: grid;
    gap: 0.55rem;
  }

  .listen-label {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .player-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .player-links a {
    display: grid;
    min-height: 3.35rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.65rem 0.7rem;
    color: var(--ink);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .player-links a > span {
    min-width: 0;
  }

  .player-links :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    stroke-width: 1.8;
  }

  .player-links :global(.external-arrow) {
    width: 0.75rem;
    height: 0.75rem;
    color: var(--muted);
  }

  .podcast-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .podcast-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-bottom: 1px solid currentColor;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .podcast-links :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
    stroke-width: 1.8;
  }

  @media (hover: hover) and (pointer: fine) {
    .player-links a:hover {
      border-color: var(--accent-strong);
      background: var(--surface-hover);
      color: var(--accent-strong);
    }

    .podcast-links a:hover {
      color: var(--accent-strong);
    }
  }

  @media (max-width: 620px) {
    .player-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .player-links {
      grid-template-columns: 1fr;
    }
  }
</style>
