---
interface Props {
  pathname: string
  title: string
  date?: string
  summary?: string
  tags?: string[]
}

const { title, summary, pathname, date, tags = [] } = Astro.props

const postUrl = `/posts/${pathname}`
const readableDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    })
  : 'Undated'
const excerpt = summary && summary !== 'undefined'
  ? summary
  : 'A note from the archive about software, productivity, creativity, or the systems around them.'
const searchIndex = [
  title,
  excerpt,
  readableDate,
  pathname.replaceAll('-', ' ').replaceAll('_', ' '),
  ...tags,
].join(' ')
---

<a href={postUrl} class="post" data-search={searchIndex}>
  <article>
    <time datetime={date}>{readableDate}</time>
    <h2>{title}</h2>
    <p>{excerpt}</p>
  </article>
</a>

<style>
  .post {
    display: block;
    min-height: 11.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
    background:
      linear-gradient(180deg, rgba(17, 21, 29, 0.94), rgba(11, 14, 20, 0.72));
    color: inherit;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .post:hover {
    transform: translateY(-2px);
    border-color: rgba(199, 91, 58, 0.48);
    box-shadow: 0 20px 58px rgba(0, 0, 0, 0.28);
  }

  article {
    display: grid;
    min-height: 9.5rem;
    align-content: space-between;
    gap: 1rem;
  }

  time {
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.18rem, 2vw, 1.55rem);
    line-height: 1.18;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
</style>
