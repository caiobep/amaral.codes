---
import { Download, Presentation } from '@lucide/astro'
import TalkMaterialPreview from './TalkMaterialPreview.astro'
import type { EntryData } from '../content/schemas'

interface Props {
  talk: NonNullable<EntryData['talk']>
}

const { talk } = Astro.props
const formatLabels = {
  talk: 'Talk',
  workshop: 'Workshop',
  brownbag: 'Brownbag',
} as const
const languageLabels = {
  en: 'English',
  'pt-BR': 'Portuguese',
} as const
const details = [
  formatLabels[talk.format],
  talk.event,
  talk.language ? languageLabels[talk.language] : undefined,
].filter(Boolean)
const materialTypeLabels = {
  pdf: 'PDF',
  keynote: 'Keynote',
  powerpoint: 'PowerPoint',
} as const
const pdfMaterials = talk.materials.filter((material) => material.type === 'pdf')
const downloadMaterials = talk.materials.filter((material) => material.type !== 'pdf')
---

<div class="talk-materials">
  <section class="talk-details" aria-label="Talk materials">
    <div class="talk-heading">
      <Presentation aria-hidden="true" />
      <div>
        <span>Talk materials</span>
        <p>{details.join(' · ')}</p>
      </div>
    </div>

    {downloadMaterials.length
      ? (
        <ul class="material-links">
          {downloadMaterials.map((material) => (
            <li>
              <a href={material.url} download>
                <Download aria-hidden="true" />
                <span>{material.label}</span>
                <small>{materialTypeLabels[material.type]}</small>
              </a>
            </li>
          ))}
        </ul>
        )
      : null}
  </section>

  {pdfMaterials.map((material, index) => (
    <TalkMaterialPreview material={material} previewId={`talk-preview-${index + 1}`} />
  ))}
</div>

<style>
  .talk-details {
    display: flex;
    width: min(100%, 740px);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin: clamp(2.25rem, 4vw, 3rem) auto 0;
    border-bottom: 1px solid var(--line);
    padding: 0 0 1.4rem;
  }

  .talk-heading {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
  }

  .talk-heading :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
    flex: 0 0 auto;
    color: var(--accent-strong);
    stroke-width: 1.7;
  }

  .talk-heading span {
    color: var(--accent-strong);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .talk-heading p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    line-height: 1.5;
  }

  .material-links {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .material-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--line);
    padding: 0.65rem 0.8rem;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .material-links a :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    flex: 0 0 auto;
    stroke-width: 1.8;
  }

  .material-links small {
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (hover: hover) and (pointer: fine) {
    .material-links a:hover {
      border-color: var(--accent-strong);
      color: var(--accent-strong);
    }
  }

  @media (max-width: 620px) {
    .talk-details {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .material-links {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
