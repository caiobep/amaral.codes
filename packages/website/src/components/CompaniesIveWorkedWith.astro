---
import ImageLink from './ImageLink.astro'

const companies = [
  ['https://www.bancobmg.com.br', '/photos/clients/bmg.webp', 'Banco BMG'],
  ['https://embraer.com', '/photos/clients/embraer.webp', 'Embraer'],
  ['https://www.itv.com', '/photos/clients/itv.webp', 'ITV'],
  ['https://www.lambda3.com.br', '/photos/clients/lambda3.webp', 'Lambda3'],
  ['https://www.linkedin.com/company/resource-it-solutions/', '/photos/clients/resource.webp', 'Resource IT'],
  ['https://www.santander.com.br', '/photos/clients/santander.webp', 'Santander'],
  ['https://www.ticket.com.br', '/photos/clients/ticket.webp', 'Ticket'],
  ['https://tmamerica.com/', '/photos/clients/tokio-marine.webp', 'Tokio Marine'],
  ['https://vigil.global', '/photos/clients/vigil.webp', 'Vigil'],
  ['https://xpinc.com', '/photos/clients/xpinc.webp', 'XP Inc.'],
  ['https://xpi.com.br', '/photos/clients/xpprivate.webp', 'XP Private'],
  ['https://xpi.us', '/photos/clients/xpinvestments.webp', 'XP Securities'],
  ['https://findmypast.co.uk', '/photos/clients/findmypast.webp', 'Findmypast'],
]
---

<div class="companies">
  {companies.map(([href, src, alt]) => (
    <ImageLink href={href} src={src} alt={alt} />
  ))}
</div>

<style>
  .companies {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
    width: 100%;
  }

  .companies :global(a) {
    display: grid;
    min-height: 5.4rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.9rem;
    background:
      linear-gradient(180deg, rgba(232, 227, 213, 0.08), rgba(17, 21, 29, 0.72));
    filter: grayscale(1) contrast(0.92);
    opacity: 0.78;
    transition:
      border-color 180ms ease,
      filter 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .companies :global(a:hover) {
    border-color: rgba(200, 168, 107, 0.44);
    filter: grayscale(0.15) contrast(1);
    opacity: 1;
    transform: translateY(-2px);
  }

  .companies :global(img) {
    max-width: 7.8rem;
    max-height: 3.4rem;
    object-fit: contain;
  }
</style>
