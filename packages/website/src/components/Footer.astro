---
const linkGroups = [
  {
    title: 'Explore',
    links: {
      Home: '/',
      About: '/about',
      Projects: '/projects',
      Blog: '/posts',
      'Resume / CV': '/resume/CV.pdf',
    },
  },
  {
    title: 'Social',
    links: {
      GitHub: 'https://github.com/caiobep',
      LinkedIn: 'https://ca.linkedin.com/in/caiobep/',
      'X / Twitter': 'https://twitter.com/caicorre',
      Mastodon: 'https://mstdn.social/@caicorre',
      Letterboxd: 'https://letterboxd.com/caiobep/',
    },
  },
  {
    title: 'Contact',
    links: {
      '20 minute chat': 'https://fantastical.app/caio/20-minute-chat-with-caio',
      Projects: 'https://caicorre.notion.site/Projects-cfd6734a46ea4a038364fd596c428435?pvs=4',
      Podcasts: 'https://caicorre.notion.site/Podcasts-f4dbd1cbd73f4e16ad6d873c8de9610e',
    },
  },
]
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-intro">
      <p class="eyebrow">~/footer</p>
      <h2>Public notes, quiet systems, and ways to reach me.</h2>
      <p class="footer-note">No heavy cadence. No client roll call. Just work, notes, and links worth keeping public.</p>
    </div>

    <div class="footer-links">
      {linkGroups.map((group) => (
        <section>
          <h3>{group.title}</h3>
          <ul>
            {Object.entries(group.links).map(([label, href]) => (
              <li>
                <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}>{label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>

  <p class="copyright">© {new Date().getFullYear()} Caio Amaral Corrêa</p>
</footer>

<style>
  .footer {
    width: min(1120px, calc(100% - 64px));
    margin: 5rem auto 0;
    border-top: 1px solid var(--line);
    padding: 2.5rem 0 3rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.5fr);
    gap: 2rem;
  }

  .footer-intro h2 {
    max-width: 22rem;
    margin: 0.5rem 0 0;
    font-family: var(--display);
    font-size: clamp(1.6rem, 2.5vw, 2.3rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .footer-note {
    max-width: 24rem;
    margin: 1.25rem 0 0;
    border-left: 1px solid var(--accent);
    padding-left: 0.85rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  h3 {
    margin: 0 0 0.9rem;
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
  }

  ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.95rem;
    text-decoration: none;
  }

  a:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-line: underline;
    text-underline-offset: 0.22em;
  }

  .copyright {
    margin: 2.25rem 0 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .footer {
      width: min(1120px, calc(100% - 32px));
    }

    .footer-inner,
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
