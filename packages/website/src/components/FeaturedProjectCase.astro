---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import ProjectVisual from '../features/projects/ProjectVisual.astro'
import { formatTechnologies, getProjectHref, isExternalProject } from '../lib/content'

interface Props {
  project: CollectionEntry<'projects'>
  index: number
}

const { project, index } = Astro.props
const { Content } = await render(project)
const href = getProjectHref(project)
const external = isExternalProject(project)
const visual = project.data.visual
const projectSearchText = [
  project.data.title,
  project.data.summary,
  project.data.category,
  ...project.data.technologies,
  project.body ?? '',
].join(' ')
---

<article
  class="project-case"
  data-project
  data-project-label={project.data.category.toLocaleLowerCase('en')}
  data-project-search={projectSearchText}
>
  <a
    class="project-visual"
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    aria-label={`View ${project.data.title}`}
  >
    <ProjectVisual
      visual={visual}
      sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1180px) calc(100vw - 4rem), min(48vw, 47rem)"
      loading={index === 0 ? 'eager' : 'lazy'}
      fetchpriority={index === 0 ? 'high' : 'auto'}
    />
  </a>

  <div class="project-details">
    <div class="project-meta">
      <span>{String(index + 1).padStart(2, '0')}</span>
      <span>{project.data.category}</span>
      <span>{formatTechnologies(project)}</span>
    </div>
    <h2>
      <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
      >{project.data.title}</a>
    </h2>
    <p class="project-summary">{project.data.summary}</p>

    <div class="project-story">
      <Content />
    </div>

    <a
      class="repository-link"
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      {project.data.externalLabel ?? 'Read project notes'}
    </a>
  </div>
</article>
