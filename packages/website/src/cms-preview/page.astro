---
import EntryArticle from '../components/EntryArticle.astro'
import Layout from '../layouts/Layout.astro'
import { CMS_ORIGIN, fetchPreview, parsePreview, PREVIEW_HEADERS } from '../lib/cms-preview'

const response = await fetchPreview(Astro.request, Astro.params.id ?? '')
Object.entries(PREVIEW_HEADERS).forEach(([name, value]) => Astro.response.headers.set(name, value))
Astro.response.status = response.status
const entry = response.ok ? parsePreview(await response.json()) : undefined
const published = Astro.url.searchParams.get('revision') === 'published'
---

{entry ? (
  <EntryArticle entry={entry} preview>
    <aside slot="preview" class="preview-bar" aria-label="Local preview">
      <strong>{published ? 'Published version' : 'Saved draft'}</strong>
      <a href={`${CMS_ORIGIN}/admin/collections/entries/${Astro.params.id}`} target="_top">Back to editor</a>
      <a href={`?revision=${published ? 'draft' : 'published'}`}>{published ? 'View saved draft' : 'View published version'}</a>
    </aside>
    <Fragment set:html={entry.rendered?.html ?? ''} />
  </EntryArticle>
) : (
  <Layout title="Preview unavailable" description="Private local content preview." robots="noindex, nofollow">
    <main class="page-shell preview-error">
      <h1>{response.status === 422 ? 'Finish this draft to preview' : response.status === 401 ? 'Sign in to preview' : 'Preview unavailable'}</h1>
      <p>{response.status === 422 ? 'Add a title, slug, and valid note details in the editor, then save the draft.' : response.status === 404 ? 'This note or revision could not be found.' : 'Open the editor, sign in, and save your note before previewing.'}</p>
      <a href={`${CMS_ORIGIN}/admin`}>Open editor</a>
    </main>
  </Layout>
)}

<script>
  import { connectLivePreview } from '../lib/cms-live-preview'

  const disconnect = connectLivePreview(window, () => window.location.reload())
  window.addEventListener('pagehide', disconnect, { once: true })
</script>

<style>
  .preview-bar {
    position: relative;
    z-index: 100;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 0.8rem 1.5rem;
    background: #f5eaa5;
    color: #20251f;
    font-size: 0.875rem;
  }
  .preview-bar a { color: inherit; }
  .preview-error { padding: 4rem 0; }
</style>
