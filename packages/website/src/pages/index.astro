---
import '../styles/pages/home.css'
import '../styles/pages/home-notebook.css'
import '../styles/pages/home-responsive.css'
import CompaniesIveWorkedWith from '../components/CompaniesIveWorkedWith.astro'
import { homepageEasterEggHeadlines, homepageHeadlines } from '../data/homepage-headlines'
import Layout from '../layouts/Layout.astro'
import {
  formatTechnologies,
  getEntryIndex,
  getProjectHref,
  getProjectIndex,
  isExternalProject,
} from '../lib/content'
import { formatPostDate } from '../lib/date'
import { getEntryHref } from '../lib/routes'
import { createPageStructuredData } from '../lib/structured-data'

const { featuredEntries } = await getEntryIndex()
const { featuredProjects } = await getProjectIndex()
const [primaryProject, ...secondaryProjects] = featuredProjects
const primaryProjectHref = primaryProject ? getProjectHref(primaryProject) : undefined
const primaryProjectExternal = primaryProject ? isExternalProject(primaryProject) : false
const primaryVisual = primaryProject?.data.visual
const primarySrcset = primaryVisual?.type === 'image'
  ? primaryVisual.sources.map((source) => `${source.src} ${String(source.width)}w`).join(', ')
  : undefined
const fallbackHeadline = homepageHeadlines[0]
const showHomepagePortrait = false
const pageDescription = 'Caio Amaral’s online home for the things he makes and the ideas he wants to keep.'
const structuredData = createPageStructuredData({
  description: pageDescription,
  pathname: Astro.url.pathname,
  title: 'Caio Amaral',
  type: 'WebPage',
}, Astro.site)

---

<Layout
  title="Caio Amaral"
  description={pageDescription}
  footerFlush
  class="home-sequence"
  structuredData={structuredData}
>
  <section class="hero" data-home-slide>
    <div class:list={['hero-grid page-shell', { 'hero-grid-no-portrait': !showHomepagePortrait }]} data-hero>
      <div class="hero-copy">
        <div class="hero-sentence">
          <h1
            data-rotating-headline
            data-headlines={JSON.stringify(homepageHeadlines)}
            data-easter-egg-headlines={JSON.stringify(homepageEasterEggHeadlines)}
            data-headline-length={fallbackHeadline.emphasis.length > 44
              ? 'long'
              : fallbackHeadline.emphasis.length > 32 ? 'medium' : 'short'}
          >
            <span data-headline-lead>{fallbackHeadline.lead}</span><span data-headline-emphasis>
              {fallbackHeadline.emphasis}
            </span>
          </h1>
          <p class="hero-summary">
            This is my online home for software I’ve made, notes I’m still thinking through, and useful things I don’t want to lose.
          </p>
        </div>
        <script is:inline>
          (() => {
            const headline = document.querySelector('[data-rotating-headline]')
            if (!(headline instanceof HTMLElement)) return

            let regularVariants
            let easterEggVariants
            try {
              regularVariants = JSON.parse(headline.dataset.headlines ?? '[]')
              easterEggVariants = JSON.parse(headline.dataset.easterEggHeadlines ?? '[]')
            } catch {
              return
            }
            if (!Array.isArray(regularVariants) || regularVariants.length < 2) return
            if (!Array.isArray(easterEggVariants)) easterEggVariants = []

            const storageKey = 'amaral-home-headline'
            let previousHeadline = ''
            try {
              previousHeadline = sessionStorage.getItem(storageKey) ?? ''
            } catch {
              // A random variant still works when storage is unavailable.
            }

            const getHeadlineKey = variant => `${String(variant?.lead ?? '')}\u0000${String(variant?.emphasis ?? '')}`
            const useEasterEgg = easterEggVariants.length > 0 && Math.random() >= 0.92
            const preferredVariants = useEasterEgg ? easterEggVariants : regularVariants
            let candidates = preferredVariants.filter(variant => getHeadlineKey(variant) !== previousHeadline)
            if (candidates.length === 0) {
              candidates = regularVariants.filter(variant => getHeadlineKey(variant) !== previousHeadline)
            }
            const variant = candidates[Math.floor(Math.random() * candidates.length)]
            const lead = headline.querySelector('[data-headline-lead]')
            const emphasis = headline.querySelector('[data-headline-emphasis]')
            if (!variant || !(lead instanceof HTMLElement) || !(emphasis instanceof HTMLElement)) return

            lead.textContent = String(variant.lead ?? '')
            const emphasisText = String(variant.emphasis ?? '')
            headline.dataset.headlineLength = emphasisText.length > 44
              ? 'long'
              : emphasisText.length > 32 ? 'medium' : 'short'
            const words = emphasisText.split(' ')
            emphasis.replaceChildren(...words.flatMap((word, index) => {
              const element = document.createElement('span')
              element.className = 'headline-word'
              element.style.setProperty('--headline-word-index', String(index))
              element.textContent = word
              return index === words.length - 1
                ? [element]
                : [element, document.createTextNode(' ')]
            }))
            emphasis.dataset.headlineAnimated = 'true'
            try {
              sessionStorage.setItem(storageKey, getHeadlineKey(variant))
            } catch {
              // The selected headline does not depend on storage succeeding.
            }
          })()
        </script>
      </div>

      {showHomepagePortrait && (
        <div class="portrait-stage" data-portrait-motion>
          <img
            src="/photos/profile/home-portrait-900.webp"
            srcset="/photos/profile/home-portrait-480.webp 480w, /photos/profile/home-portrait-720.webp 720w, /photos/profile/home-portrait-900.webp 900w"
            sizes="(max-width: 660px) calc(100vw - 2.5rem), (max-width: 900px) min(34rem, calc(100vw - 4rem)), min(34vw, 28rem)"
            alt="Caio Amaral"
            width="900"
            height="1125"
            decoding="async"
          />
        </div>
      )}
    </div>
  </section>

  <section class="notebook page-shell" aria-labelledby="notebook-title" data-home-slide data-reveal>
    <div class="section-heading">
      <div>
        <p class="section-label">Notes</p>
        <h2 id="notebook-title">Recent notes.</h2>
      </div>
      <a href="/posts">See all notes</a>
    </div>

    <div class="editorial-grid">
      {featuredEntries[0] && (
        <a
          class="lead-story"
          href={getEntryHref(featuredEntries[0].id)}
          data-lead-story-motion
        >
          <div class="story-meta">
            <span>{featuredEntries[0].data.category}</span>
            <time datetime={featuredEntries[0].data.date}>
              {formatPostDate(featuredEntries[0].data.date, { month: 'short', year: 'numeric' })}
            </time>
          </div>
          <h3>{featuredEntries[0].data.title}</h3>
          <div class="lead-story-footer">
            <p>{featuredEntries[0].data.summary}</p>
            <span class="story-action">Open note</span>
          </div>
        </a>
      )}

      <div class="story-list">
        {featuredEntries.slice(1).map((entry) => (
          <a href={getEntryHref(entry.id)}>
            <div class="story-meta">
              <span>{entry.data.category}</span>
              <time datetime={entry.data.date}>
                {formatPostDate(entry.data.date, { month: 'short', year: 'numeric' })}
              </time>
            </div>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="work-band" aria-labelledby="work-title" data-home-slide>
    <div class="page-shell" data-reveal>
      <div class="work-heading">
        <div>
          <p class="section-label">Featured projects</p>
          <h2 id="work-title">Things I’ve made.</h2>
        </div>
        <a href="/projects">All projects</a>
      </div>

      <div class="project-showcase" data-stagger>
        {primaryProject && primaryProjectHref
          ? (
            <a
              class="featured-project"
              href={primaryProjectHref}
              target={primaryProjectExternal ? '_blank' : undefined}
              rel={primaryProjectExternal ? 'noopener noreferrer' : undefined}
            >
              <div class="featured-project-visual">
                {primaryVisual?.type === 'image'
                  ? (
                      <img
                        src={primaryVisual.src}
                        srcset={primarySrcset}
                        sizes="(max-width: 900px) calc(100vw - 4rem), min(58vw, 46rem)"
                        alt={primaryVisual.alt}
                        width={primaryVisual.width}
                        height={primaryVisual.height}
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  : null}
              </div>
              <div class="featured-project-copy">
                <span>{primaryProject.data.category}</span>
                <h3>{primaryProject.data.title}</h3>
                <p>{primaryProject.data.summary}</p>
                <strong>{formatTechnologies(primaryProject)}</strong>
              </div>
            </a>
            )
          : null}

        <div class="project-links">
        {secondaryProjects.slice(0, 2).map((project) => {
          const external = isExternalProject(project)

          return (
            <a
              href={getProjectHref(project)}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <div>
                <span>{project.data.category}</span>
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
              </div>
              <strong>{formatTechnologies(project)}</strong>
            </a>
          )
        })}
        </div>
      </div>
    </div>
  </section>

  <section class="work-context page-shell" aria-labelledby="work-context-title" data-home-slide data-reveal>
    <div class="section-heading">
      <div>
        <p class="section-label">Work context</p>
        <h2 id="work-context-title">Teams and products I’ve worked with.</h2>
      </div>
      <a href="/projects">See projects</a>
    </div>
    <CompaniesIveWorkedWith />
  </section>

  <section class="closing page-shell" data-home-slide data-reveal>
    <div class="contact-copy">
      <p class="section-label">Contact</p>
      <h2>Tell me what brought you here.</h2>
      <p>If you’re hiring, building something, or have a question, a little context is enough.</p>
      <a class="button" href="/contact">Get in touch</a>
    </div>
  </section>
</Layout>
