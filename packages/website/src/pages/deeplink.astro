<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" /> 
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting...</title>
  </head>
  <body>
    <div>
      <h1>Redirecting...</h1>
    </div>
  </body>
  
  <script lang="ts">
    const searchParams = new URLSearchParams(window.location.search);

    const deeplink = searchParams.get('l');
    if (deeplink) {
      window.location.href = deeplink
      return
    }

    const shortcutlink = searchParams.get('s')
    if (shortcutLink) {
      window.location.href = `shortcuts://run-shortcut?name=${shortcutlink}`
      return
    }

  </script>
</html>
