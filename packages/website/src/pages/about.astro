---
import CompaniesIveWorkedWith from '../components/CompaniesIveWorkedWith.astro'
import Heading from '../components/Heading.astro'
import Layout from '../layouts/Layout.astro'
import { createPageStructuredData } from '../lib/structured-data'
const pageDescription = 'About Caio Amaral, his work in software, and the interests behind amaral.codes.'
const structuredData = createPageStructuredData({
  description: pageDescription,
  pathname: Astro.url.pathname,
  title: 'About',
  type: 'ProfilePage',
}, Astro.site)

---

<Layout
  title="About"
  description={pageDescription}
  structuredData={structuredData}
>
  <section class="about-hero page-shell" data-reveal>
    <div class="hero-copy">
      <p class="eyebrow">About</p>
      <Heading level={1}>Most of my interests start with software and end up somewhere else.</Heading>
      <p>
        I usually start with a tool or a piece of software, then follow the question into reliability, accessibility, habits, or whatever else it touches.
      </p>
      <a class="cv-link" href="/resume/CV.pdf" target="_blank" rel="noopener noreferrer">
        View my CV <span aria-hidden="true">↗</span>
      </a>
    </div>

    <figure data-portrait-motion>
      <img
        src="/photos/profile/about-portrait-1080.webp"
        srcset="/photos/profile/about-portrait-480.webp 480w, /photos/profile/about-portrait-720.webp 720w, /photos/profile/about-portrait-1080.webp 1080w"
        sizes="(max-width: 680px) calc(100vw - 32px), (max-width: 820px) 37vw, (max-width: 1000px) 512px, min(336px, 27vw)"
        alt="Caio Amaral sitting at a table"
        width="1080"
        height="1350"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </section>

  <section class="story page-shell" aria-labelledby="story-title" data-reveal>
    <div class="story-heading">
      <p class="section-label">Why this site exists</p>
      <Heading id="story-title">My thoughts, at full length.</Heading>
    </div>
    <div class="story-copy">
      <p>
        This is where I write what I think, in my own words, with room to get into the details. Software, music, design, or whatever else has my attention.
      </p>
      <p>
        I write about what I tried, what worked, what frustrated me, and what I’m still figuring out. These are my views as they stand when I write them. There’s room to change my mind.
      </p>
    </div>
  </section>

  <section class="work-context page-shell" aria-labelledby="work-context-title" data-reveal>
    <div class="work-heading">
      <div>
        <p class="section-label">Work context</p>
        <Heading id="work-context-title">Teams and products I’ve worked with.</Heading>
      </div>
    </div>
    <CompaniesIveWorkedWith annotated />
  </section>

  <section class="interests-band" aria-labelledby="interests-title" data-reveal>
    <div class="page-shell interests">
      <div>
        <p class="section-label">What ends up here</p>
        <Heading id="interests-title">Whatever I keep thinking about.</Heading>
      </div>
      <div class="interest-copy">
        <p>
          I notice interfaces that stay out of the way, and reliability problems that survive the obvious fix.
        </p>
        <p>
          I also try more personal tools and organizational systems than I keep. Writing down why I left one behind is usually more useful than documenting the setup.
        </p>
        <p>
          Not everything needs to become a software lesson. Movies, music, books, and photos live here because I wanted to remember them.
        </p>
      </div>
    </div>
  </section>

  <section class="next page-shell" data-reveal>
    <div>
      <p class="section-label">Continue reading</p>
      <Heading>The notes are the better introduction.</Heading>
    </div>
    <a class="button" href="/posts">Browse all notes</a>
  </section>
</Layout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.36fr) minmax(18rem, 0.64fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding: clamp(4.25rem, 7vw, 6.25rem) 0 clamp(3.75rem, 6vw, 5.5rem);
  }

  .about-hero .eyebrow {
    margin-bottom: 0.8rem;
  }

  .hero-copy > p:not(.eyebrow) {
    max-width: 39rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .cv-link {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: 1.4rem;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.28rem;
  }

  .cv-link span {
    transition: transform 180ms var(--ease);
  }

  figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 4 / 5;
    background-color: var(--accent-soft);
    background-image: url('/textures/material-noise.webp');
    background-size: 240px 240px;
    background-blend-mode: soft-light;
  }

  figure::after {
    position: absolute;
    inset: 0;
    border: 1px solid var(--border-subtle);
    border-radius: inherit;
    content: "";
    pointer-events: none;
  }

  figure img {
    position: absolute;
    inset: -7px;
    width: calc(100% + 14px);
    max-width: none;
    height: calc(100% + 14px);
    transform:
      translateX(var(--portrait-x, 0px))
      translateY(var(--portrait-y, 0px));
    object-fit: cover;
    object-position: center 35%;
    filter: grayscale(1) contrast(1.03);
    mix-blend-mode: var(--portrait-blend);
    transition: transform 480ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .cv-link:hover span {
      transform: translate(2px, -2px);
    }

    figure:hover img {
      transform:
        translateX(var(--portrait-x, 0px))
        translateY(var(--portrait-y, 0px))
        scale(1.015);
    }
  }

  .story {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    border-top: 1px solid var(--line);
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }

  .story-heading {
    grid-column: 1 / span 6;
  }

  .story-copy {
    grid-column: 5 / span 7;
    max-width: 43rem;
    margin-top: clamp(3.5rem, 7vw, 6.5rem);
  }

  .story-copy p {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .story-copy p:first-child {
    color: var(--ink);
    font-size: 1.2rem;
  }

  .work-context {
    border-top: 1px solid var(--line);
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }

  .work-heading {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .interests-band {
    background-color: var(--accent-faint);
  }

  .interests {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 3rem;
    align-items: start;
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }

  .interest-copy {
    max-width: 43rem;
  }

  .interest-copy p {
    margin: 0 0 1.25rem;
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.72;
  }

  .interest-copy p:last-child {
    margin-bottom: 0;
  }

  .next {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--line);
    padding: 4rem 0 1rem;
  }

  @media (max-width: 1000px) {
    .about-hero {
      grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
      gap: clamp(1.75rem, 4vw, 3rem);
    }

    figure {
      width: 100%;
    }
  }

  @media (min-width: 681px) and (max-width: 820px) {
    .about-hero {
      grid-template-columns: minmax(0, 1.18fr) minmax(16rem, 0.82fr);
      gap: 1.75rem;
      padding-top: 3.5rem;
    }

    .hero-copy {
      grid-column: 1;
      grid-row: 1;
    }

    figure {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      width: 100%;
    }

  }

  @media (max-width: 680px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 3.25rem;
    }

    .about-hero > .eyebrow,
    .hero-copy,
    figure {
      grid-column: 1;
    }

    .about-hero > .eyebrow {
      padding-top: 0;
    }

    .story,
    .interests {
      grid-template-columns: 1fr;
    }

    .story-heading,
    .story-copy,
    .interests > div:first-child,
    .interest-copy,
    .interest-copy p,
    .interest-copy p:first-child,
    .interest-copy p:nth-child(2),
    .interest-copy p:nth-child(3) {
      grid-column: 1;
    }

    .story-copy {
      margin-top: 2.5rem;
    }

    .interest-copy {
      margin-top: 0;
    }

    .next {
      align-items: flex-start;
      flex-direction: column;
    }
  }

</style>
