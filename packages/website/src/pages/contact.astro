---
import Layout from '../layouts/Layout.astro'
import Heading from '../components/Heading.astro'
import { ArrowUpRight, ArrowRight } from '@lucide/astro'
import { createPageStructuredData } from '../lib/structured-data'

const description = 'Get in touch with Caio Amaral about a project, a question, or a conversation.'
const emailOptions = [
  {
    title: 'A project or collaboration',
    detail: 'What you’re building and where I could help.',
    subject: 'A project or collaboration',
  },
  {
    title: 'Something I made or wrote',
    detail: 'A question, a follow-up, or another perspective.',
    subject: 'About your work',
  },
  {
    title: 'Just saying hello',
    detail: 'No pitch or particular reason needed.',
    subject: 'Hello, Caio',
  },
]
const profiles = [
  { label: 'GitHub', detail: 'Code, projects, and experiments', href: 'https://github.com/caiobep' },
  { label: 'LinkedIn', detail: 'Work and professional connections', href: 'https://ca.linkedin.com/in/caiobep/' },
  { label: 'X / Twitter', detail: 'Notes and public conversations', href: 'https://twitter.com/caicorre' },
]
const structuredData = createPageStructuredData({
  description,
  pathname: Astro.url.pathname,
  title: 'Contact',
  type: 'ContactPage',
}, Astro.site)
---

<Layout title="Contact" description={description} structuredData={structuredData}>
  <section class="contact page-shell" aria-labelledby="contact-title">
    <header class="contact-intro">
      <p class="eyebrow">Contact</p>
      <Heading level={1} id="contact-title">What’s on your mind?</Heading>
      <p>A project you’re working on, a question about something I’ve written,<br /> or an introduction. I’d like to hear from you.</p>
    </header>

    <div class="contact-layout">
      <section class="email-start" aria-labelledby="email-title">
        <p class="section-label">By email</p>
        <h2 id="email-title">Start a conversation.</h2>
        <p class="email-intro">Choose a starting point below.<br />You’ll write the rest in your email app.</p>
        <div class="email-options">
          {emailOptions.map((option) => (
            <button type="button" data-email-subject={option.subject} disabled>
              <span><strong>{option.title}</strong><small>{option.detail}</small></span>
              <ArrowRight aria-hidden="true" />
            </button>
          ))}
        </div>
        <noscript><p>Enable JavaScript to email me, or use LinkedIn alongside.</p></noscript>
      </section>

      <aside class="contact-sidebar" aria-label="Other ways to connect">
        <section class="calendar" aria-labelledby="calendar-title">
          <p class="section-label">Face to face</p>
          <h2 id="calendar-title">Sometimes it’s<br />easier to talk.</h2>
          <p>Set aside twenty minutes for a conversation.</p>
          <a href="https://fantastical.app/caio/20-minute-chat-with-caio" target="_blank" rel="noopener noreferrer">
            Book a 20-minute chat <ArrowUpRight aria-hidden="true" />
          </a>
        </section>
        <nav class="profiles" aria-label="Social profiles">
          <p class="section-label">Elsewhere</p>
          {profiles.map((profile) => (
            <a href={profile.href} target="_blank" rel="noopener noreferrer">
              <span><strong>{profile.label}</strong><small>{profile.detail}</small></span>
              <ArrowUpRight aria-hidden="true" />
            </a>
          ))}
        </nav>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const initializeContactEmail = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-email-subject]')
    for (const button of buttons) {
      button.disabled = false
      button.onclick = () => {
        const recipient = ['caiobep', 'me.com'].join('@')
        const subject = encodeURIComponent(button.dataset.emailSubject ?? '')
        const link = document.createElement('a')
        link.href = ['mailto', recipient].join(':') + '?subject=' + subject
        link.click()
      }
    }
  }

  document.addEventListener('astro:page-load', initializeContactEmail)
  initializeContactEmail()
</script>

<style>
  .contact {
    max-width: 74rem;
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .contact-intro { margin-bottom: 2.75rem; }
  .eyebrow { margin-bottom: 0.9rem; }

  .contact-intro > p:last-child {
    margin: 0;
    max-width: 43rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(17rem, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: stretch;
  }

  .email-start {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line-strong);
    padding-top: calc(1.75rem - 1px);
  }

  .email-start h2 {
    margin: 0.75rem 0 1rem;
    font-family: var(--section-heading-font);
    font-size: clamp(2.2rem, 3vw, 2.75rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.15;
  }

  .email-intro {
    margin: 0 0 2rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
  }

  .email-options {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    flex: 1;
    border-top: 1px solid var(--line);
  }

  .email-options button {
    display: flex;
    width: 100%;
    min-height: 6.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 1.4rem 1rem 1.4rem 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .email-options strong {
    display: block;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .email-options small {
    display: block;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .email-options button:disabled { opacity: 0.5; cursor: default; }

  button :global(svg),
  a :global(svg) { width: 1rem; height: 1rem; flex-shrink: 0; }

  .calendar {
    padding: 1.75rem;
    border-radius: 6px;
    background: var(--dark);
    color: var(--dark-ink);
  }
  .calendar .section-label { color: var(--dark-caption); }
  .calendar h2 {
    margin: 0.75rem 0 1rem;
    font-family: var(--section-heading-font);
    font-size: 2.15rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.15;
  }
  .calendar > p:not(.section-label) { color: var(--dark-muted); font-size: 0.9rem; line-height: 1.6; }
  .calendar a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--dark-line);
    padding-top: 1rem;
    color: var(--dark-ink);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .profiles { margin-top: 2rem; }
  .profiles > p { margin-bottom: 0.6rem; }
  .profiles a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .profiles strong { display: block; font-size: 0.9rem; font-weight: 600; }
  .profiles small { display: block; margin-top: 0.3rem; color: var(--muted); font-size: 0.8rem; }

  :is(a, button):focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .calendar a:focus-visible { outline-color: var(--dark-ink); }

  @media (hover: hover) {
    .profiles a:hover strong { color: var(--accent-strong); }
    .calendar a:hover { text-decoration: underline; text-underline-offset: 0.25em; }
    .email-options button:hover:not(:disabled) { background: var(--accent-faint); }
    .email-options button:hover:not(:disabled) strong { color: var(--accent-strong); }
  }

  @media (max-width: 760px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-intro br { display: none; }
    .contact-intro { margin-bottom: 2rem; }
  }
</style>
