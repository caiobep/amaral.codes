---
import '../../styles/pages/posts.css'
import { Search, X } from '@lucide/astro'
import PageIntro from '../../components/PageIntro.astro'
import EntryPreview from '../../components/EntryPreview.astro'
import CategoryIcon from '../../features/entries/CategoryIcon.astro'
import Layout from '../../layouts/Layout.astro'
import { ENTRY_CATEGORY_PRESENTATIONS } from '../../features/entries/category-presentation'
import { getEntryIndex, getEntryTopics } from '../../lib/content'
import { createPageStructuredData } from '../../lib/structured-data'

const {
  counts,
  entries,
} = await getEntryIndex()

const filters = [
  { value: 'all' as const, label: 'All', count: entries.length },
  ...ENTRY_CATEGORY_PRESENTATIONS.map(({ category, filterLabel }) => ({
    value: category,
    label: filterLabel,
    count: counts[category],
  })).filter(({ count }) => count > 0),
]
const pageDescription = 'Essays, notes, reviews, links, and observations by Caio Amaral.'
const structuredData = createPageStructuredData({
  description: pageDescription,
  pathname: Astro.url.pathname,
  title: 'Notes',
  type: 'CollectionPage',
}, Astro.site)
---

<Layout
  title="Notes"
  description={pageDescription}
  structuredData={structuredData}
>
  <PageIntro
    title="Notes, podcasts, and talks."
    summary="Software, tools, media, and things I wanted to remember."
    variant="compact"
  />

  <section id="post-index" class="search-section page-shell" role="search" aria-label="Find notes" data-reveal data-stagger>
    <div class="library-index-copy">
      <p>Library index</p>
      <span>Search the collection or browse by type.</span>
    </div>
    <label class="post-search">
      <span class="control-label">Search the library</span>
      <span class="post-search-field">
        <Search aria-hidden="true" size={18} stroke-width={1.8} />
        <input
          type="search"
          placeholder="Title, topic, or date..."
          id="search-post"
          autocomplete="off"
          aria-controls="post-results"
        />
        <button type="button" class="post-search-clear" aria-label="Clear note search" data-clear-post-query hidden>
          <X aria-hidden="true" />
        </button>
      </span>
    </label>
    <fieldset class="post-filters">
      <legend>Browse the shelves</legend>
      <div class="post-filter-options">
        {filters.map((filter) => {
          return (
            <button
              type="button"
              data-filter={filter.value}
              aria-controls="post-results"
              aria-pressed={filter.value === 'all' ? 'true' : 'false'}
            >
              <CategoryIcon category={filter.value} />
              <span>{filter.label}</span>
              <strong>{filter.count}</strong>
            </button>
          )
        })}
      </div>
    </fieldset>
    <p class="search-status" aria-live="polite">
      Showing <span id="visible-post-count">{entries.length}</span> entries.
    </p>
  </section>

  <section id="post-results" class="posts page-shell" aria-label="Note results">
    {entries.map((entry) => (
      <EntryPreview
        translation={entry.data.translation}
        title={entry.data.title}
        summary={entry.data.summary}
        date={entry.data.date}
        pathname={entry.id}
        tags={getEntryTopics(entry)}
        category={entry.data.category}
      />
    ))}
    <div class="empty-state" hidden>
      <p>No matches</p>
      <h2>Nothing matches that search.</h2>
      <span>Try a broader term, switch filters, or clear the search.</span>
      <button type="button" data-clear-search>Clear search</button>
    </div>
    <div class="end-state" data-end-state>
      <p>That’s all for now.</p>
      <span>You’ve reached the end of these results.</span>
    </div>
  </section>
</Layout>

<script>
  import '../../scripts/posts'
</script>
