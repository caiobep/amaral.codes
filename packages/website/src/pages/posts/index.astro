---
import { getCollection } from 'astro:content'
import PostPreview from '../../components/PostPreview.astro'
import Layout from '../../layouts/Layout.astro'

const posts = (await getCollection('blog-posts'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
---

<Layout
  title="Posts"
  description="Short posts, essays, notes, and opinions by Caio Amaral about software, productivity, design, history, creativity, and human-computer interaction."
>
  <section class="posts-hero page-shell">
    <p class="eyebrow">Blog</p>
    <h1>Writing, notes, and short observations.</h1>
    <p>
      A living archive for software, productivity, design, learning, media, and the ideas I want to keep in circulation.
    </p>
  </section>

  <section class="search-section page-shell" aria-label="Search posts">
    <label>
      <span>Search posts</span>
      <input type="search" placeholder="Search by title or summary" id="search-post" autocomplete="off" />
    </label>
  </section>

  <section class="posts page-shell" aria-label="All posts">
    {posts.map((post) => (
      <PostPreview
        title={post.data.title}
        summary={post.data.summary}
        date={post.data.date}
        pathname={post.slug}
      />
    ))}
  </section>
</Layout>

<script>
  const initializePosts = () => {
    const postsContainer = document.querySelector('.posts')
    const searchInput = document.querySelector('#search-post')

    const filterPosts = () => {
      if (!(searchInput instanceof HTMLInputElement) || !postsContainer) return
      const query = searchInput.value.toLowerCase()
      postsContainer.querySelectorAll('.post').forEach((post) => {
        const content = post instanceof HTMLElement ? post.dataset.title?.toLowerCase() || '' : ''
        post.classList.toggle('hidden', !content.includes(query))
      })
    }

    searchInput?.addEventListener('input', filterPosts)
    window.addEventListener('keydown', (event) => {
      const command = event.metaKey || event.ctrlKey
      if (command && event.key.toLowerCase() === 'k' && searchInput instanceof HTMLInputElement) {
        event.preventDefault()
        searchInput.focus()
      }
    })
  }

  document.addEventListener('astro:page-load', initializePosts)
  initializePosts()
</script>

<style>
  .posts-hero {
    max-width: 820px;
    padding: 4rem 0 2rem;
  }

  h1 {
    margin: 0.8rem 0 1rem;
    font-family: var(--display);
    font-size: clamp(3rem, 6vw, 5.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  .posts-hero p:last-child {
    max-width: 48rem;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .search-section {
    padding: 1rem 0 2rem;
  }

  label {
    display: grid;
    gap: 0.5rem;
  }

  label span {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  input {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 1rem 0;
    background: transparent;
    color: var(--ink);
    font-size: 1.1rem;
    outline: none;
  }

  input:focus {
    border-color: var(--ink);
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-bottom: 5rem;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 980px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .posts {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: clamp(2.7rem, 12vw, 4.4rem);
    }
  }
</style>
