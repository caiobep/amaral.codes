---
import { getCollection } from 'astro:content'
import PostPreview from '../../components/PostPreview.astro'
import Layout from '../../layouts/Layout.astro'

const posts = (await getCollection('blog-posts'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())

const shelves = [
  {
    title: 'Essays',
    detail: 'Longer thoughts about software, systems, learning, and the way tools shape behavior.',
  },
  {
    title: 'Notes',
    detail: 'Shorter observations, unfinished ideas, references, and things worth keeping in public.',
  },
  {
    title: 'Reviews',
    detail: 'Movies, books, apps, games, talks, and anything else that deserves more than a private rating.',
  },
  {
    title: 'Links',
    detail: 'External material with enough context that future me can remember why it mattered.',
  },
]
---

<Layout
  title="Archive"
  description="A public archive of essays, notes, reviews, links, and observations by Caio Amaral."
>
  <section class="posts-hero page-shell">
    <p class="eyebrow">~/archive</p>
    <h1>Essays, notes, reviews, and short observations.</h1>
    <p>
      This is where a software note, a productivity reflection, a movie review, a book fragment, or a link with context can all live without needing to become a polished article.
    </p>
  </section>

  <section class="shelves page-shell" aria-label="Archive shelves">
    {shelves.map((shelf) => (
      <article>
        <h2>{shelf.title}</h2>
        <p>{shelf.detail}</p>
      </article>
    ))}
  </section>

  <section class="search-section page-shell" aria-label="Search posts">
    <label>
      <span>Search archive</span>
      <input type="search" placeholder="Search notes, reviews, links, and essays" id="search-post" autocomplete="off" />
    </label>
    <p class="search-status" aria-live="polite">
      Showing <span id="visible-post-count">{posts.length}</span> of {posts.length} entries.
    </p>
  </section>

  <section class="posts page-shell" aria-label="All archive entries">
    {posts.map((post) => (
      <PostPreview
        title={post.data.title}
        summary={post.data.summary}
        date={post.data.date}
        pathname={post.slug}
        tags={post.data.tags?.map((tag) => tag.name)}
      />
    ))}
  </section>

  <p class="empty-state page-shell" hidden>No entries match that search.</p>
</Layout>

<script>
  const initializePosts = () => {
    const postsContainer = document.querySelector('.posts')
    const searchInput = document.querySelector('#search-post')
    const visiblePostCount = document.querySelector('#visible-post-count')
    const emptyState = document.querySelector('.empty-state')

    const normalize = (value) =>
      value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')

    const filterPosts = () => {
      if (!(searchInput instanceof HTMLInputElement) || !postsContainer) return
      const query = normalize(searchInput.value.trim())
      let visibleCount = 0

      postsContainer.querySelectorAll('.post').forEach((post) => {
        const content = post instanceof HTMLElement ? normalize(post.dataset.search || post.textContent || '') : ''
        const isVisible = !query || content.includes(query)

        post.classList.toggle('hidden', !isVisible)
        if (isVisible) visibleCount += 1
      })

      if (visiblePostCount) visiblePostCount.textContent = String(visibleCount)
      if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount !== 0

      const url = new URL(window.location.href)
      if (query) {
        url.searchParams.set('q', searchInput.value.trim())
      } else {
        url.searchParams.delete('q')
      }
      window.history.replaceState({}, '', url)
    }

    searchInput?.addEventListener('input', filterPosts)

    if (searchInput instanceof HTMLInputElement) {
      searchInput.value = new URLSearchParams(window.location.search).get('q') || ''
      filterPosts()
    }

    window.addEventListener('keydown', (event) => {
      const command = event.metaKey || event.ctrlKey
      if (command && event.key.toLowerCase() === 'k' && searchInput instanceof HTMLInputElement) {
        event.preventDefault()
        searchInput.focus()
      }
    })
  }

  document.addEventListener('astro:page-load', initializePosts)
  initializePosts()
</script>

<style>
  .posts-hero {
    max-width: 820px;
    padding: 4rem 0 2rem;
  }

  h1 {
    margin: 0.8rem 0 1rem;
    font-family: var(--display);
    font-size: clamp(3rem, 6vw, 5.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  .posts-hero p:last-child {
    max-width: 48rem;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .search-section {
    display: grid;
    gap: 0.85rem;
    padding: 1rem 0 2rem;
  }

  .shelves {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 1rem 0 1.5rem;
  }

  .shelves article {
    min-height: 9.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.95rem;
    background: linear-gradient(180deg, rgba(17, 21, 29, 0.94), rgba(11, 14, 20, 0.72));
  }

  .shelves h2 {
    margin: 0 0 0.5rem;
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .shelves p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  label {
    display: grid;
    gap: 0.5rem;
  }

  label span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.85rem 0.95rem;
    background: rgba(17, 21, 29, 0.64);
    color: var(--ink);
    font-size: 1.1rem;
    outline: none;
  }

  input:focus {
    border-color: rgba(199, 91, 58, 0.64);
    box-shadow: 0 0 0 4px rgba(199, 91, 58, 0.12);
  }

  .search-status,
  .empty-state {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .empty-state {
    padding: 0 0 5rem;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-bottom: 5rem;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 980px) {
    .posts,
    .shelves {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .posts,
    .shelves {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: clamp(2.7rem, 12vw, 4.4rem);
    }
  }
</style>
