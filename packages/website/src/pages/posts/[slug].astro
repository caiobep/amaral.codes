---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog-posts')

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await post.render()
const { title, date, tags, summary } = post.data
---

<Layout
  title={title}
  description={summary && summary !== 'undefined' ? summary : `A post by Caio Amaral about ${tags?.map((tag) => tag.name).join(', ') || 'software, ideas, and personal systems'}.`}
>
  <article class="post page-shell">
    <header>
      <a href="/posts" class="back-link">Back to posts</a>
      <time datetime={date}>{new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
      <h1>{title}</h1>
      {tags?.length ? (
        <ul>
          {tags.map((tag) => <li>{tag.name}</li>)}
        </ul>
      ) : null}
    </header>

    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<script>
  const enhanceBookmarks = () => {
    document.querySelectorAll('.content p').forEach((paragraph) => {
      const links = paragraph.querySelectorAll('a')
      const text = paragraph.textContent?.trim().toLowerCase()

      if (links.length !== 1 || text !== 'bookmark') return

      const link = links[0]
      let domain = link.href

      try {
        domain = new URL(link.href).hostname.replace(/^www\./, '')
      } catch {
        domain = link.href
      }

      const card = document.createElement('a')
      card.className = 'bookmark-card'
      card.href = link.href
      card.target = '_blank'
      card.rel = 'noopener noreferrer'

      const label = document.createElement('span')
      label.textContent = 'bookmark'

      const title = document.createElement('strong')
      title.textContent = domain

      card.append(label, title)

      paragraph.replaceWith(card)
    })
  }

  document.addEventListener('astro:page-load', enhanceBookmarks)
  enhanceBookmarks()
</script>

<style>
  .post {
    max-width: 760px;
    padding: 3.5rem 0 5rem;
  }

  header {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .back-link,
  time {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 750;
  }

  h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.88rem;
  }

  .content {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.72;
  }

  .content :global(p),
  .content :global(ul),
  .content :global(ol),
  .content :global(blockquote) {
    margin: 1rem 0;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    margin: 2rem 0 0.65rem;
    line-height: 1.12;
  }

  .content :global(h2) {
    font-family: var(--display);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .content :global(h3) {
    font-size: 1.32rem;
  }

  .content :global(a) {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .content :global(.bookmark-card) {
    display: grid;
    gap: 0.35rem;
    margin: 1.25rem 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.9rem 1rem;
    background:
      linear-gradient(180deg, rgba(17, 21, 29, 0.94), rgba(11, 14, 20, 0.72));
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .content :global(.bookmark-card:hover) {
    border-color: rgba(199, 91, 58, 0.48);
    transform: translateY(-2px);
    box-shadow: 0 20px 58px rgba(0, 0, 0, 0.28);
  }

  .content :global(.bookmark-card span) {
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .content :global(.bookmark-card strong) {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .content :global(img) {
    width: auto;
    max-width: min(100%, 680px);
    max-height: 460px;
    height: auto;
    margin: 1.5rem auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    object-fit: contain;
    background: var(--paper-strong);
    box-shadow: 0 22px 64px rgba(0, 0, 0, 0.28);
  }

  .content :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .content :global(pre) {
    overflow-x: auto;
    border-radius: 8px;
    padding: 1.2rem;
    background: #11151d;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .post {
      padding-top: 2.5rem;
    }

    h1 {
      font-size: clamp(2.1rem, 10vw, 3.5rem);
    }

    .content :global(img) {
      max-height: 320px;
      margin: 1.25rem auto;
    }

    .content :global(iframe) {
      min-height: auto;
    }
  }
</style>
