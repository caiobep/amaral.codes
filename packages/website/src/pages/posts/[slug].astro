---
import { render } from 'astro:content'
import EntryArticle from '../../components/EntryArticle.astro'
import { getEntryIndex, selectNextReads } from '../../lib/content'

export async function getStaticPaths() {
  const { entries } = await getEntryIndex()

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, nextReads: selectNextReads(entries, entry.id) },
  }))
}

const { entry, nextReads } = Astro.props
const normalizeArticleMarkup = (html: string) => (
  html.replace(/<(\/?)h1(?=[\s>])/g, '<$1h2')
)
const renderableEntry = entry.rendered
  ? {
      ...entry,
      rendered: {
        ...entry.rendered,
        html: normalizeArticleMarkup(entry.rendered.html),
      },
    }
  : entry
const { Content } = await render(renderableEntry)
---

<EntryArticle entry={entry} nextReads={nextReads}>
  <Content />
</EntryArticle>
