---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog-posts')

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await post.render()
const { title, date, tags, summary } = post.data
---

<Layout
  title={title}
  description={summary && summary !== 'undefined' ? summary : `A post by Caio Amaral about ${tags?.map((tag) => tag.name).join(', ') || 'software, ideas, and personal systems'}.`}
>
  <article class="post page-shell">
    <header>
      <a href="/posts" class="back-link">Back to posts</a>
      <time datetime={date}>{new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
      <h1>{title}</h1>
      {tags?.length ? (
        <ul>
          {tags.map((tag) => <li>{tag.name}</li>)}
        </ul>
      ) : null}
    </header>

    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<script>
  const enhanceExternalCards = () => {
    document.querySelectorAll('.content p').forEach((paragraph) => {
      const links = paragraph.querySelectorAll('a')
      const text = paragraph.textContent?.trim()

      if (links.length !== 1 || !text) return

      const link = links[0]
      let domain = link.href

      try {
        domain = new URL(link.href).hostname.replace(/^www\./, '')
      } catch {
        domain = link.href
      }

      const card = document.createElement('a')
      card.className = 'external-card'
      card.href = link.href
      card.target = '_blank'
      card.rel = 'noopener noreferrer'

      const label = document.createElement('span')
      label.textContent = 'external link'

      const title = document.createElement('strong')
      title.textContent = text === domain ? domain : text

      card.append(label, title)

      paragraph.replaceWith(card)
    })
  }

  document.addEventListener('astro:page-load', enhanceExternalCards)
  enhanceExternalCards()
</script>

<style>
  .post {
    max-width: 760px;
    padding: 3.5rem 0 5rem;
  }

  header {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .back-link,
  time {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 750;
  }

  h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.88rem;
  }

  .content {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.72;
  }

  .content :global(p),
  .content :global(ul),
  .content :global(ol),
  .content :global(blockquote) {
    margin: 1rem 0;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    margin: 2rem 0 0.65rem;
    line-height: 1.12;
  }

  .content :global(h2) {
    font-family: var(--display);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .content :global(h3) {
    font-size: 1.32rem;
  }

  .content :global(a) {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .content :global(.external-card) {
    display: grid;
    gap: 0.35rem;
    margin: 1.25rem 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.9rem 1rem;
    background:
      linear-gradient(180deg, rgba(17, 21, 29, 0.94), rgba(11, 14, 20, 0.72));
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .content :global(.external-card:hover) {
    border-color: rgba(199, 91, 58, 0.48);
    transform: translateY(-2px);
    box-shadow: 0 20px 58px rgba(0, 0, 0, 0.28);
  }

  .content :global(.external-card span) {
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .content :global(.external-card strong) {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .content :global(.archived-reference) {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .content :global(img) {
    width: auto;
    max-width: min(100%, 680px);
    max-height: 460px;
    height: auto;
    margin: 1.5rem auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    object-fit: contain;
    background: var(--paper-strong);
    box-shadow: 0 22px 64px rgba(0, 0, 0, 0.28);
  }

  .content :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .content :global(:not(pre) > code) {
    border: 1px solid rgba(139, 191, 130, 0.2);
    border-radius: 5px;
    padding: 0.08rem 0.32rem;
    background: rgba(139, 191, 130, 0.08);
    color: var(--phosphor);
    font-family: var(--mono);
    font-size: 0.9em;
    font-weight: 650;
  }

  .content :global(pre) {
    position: relative;
    overflow-x: auto;
    margin: 1.6rem 0;
    border: 1px solid rgba(200, 168, 107, 0.2);
    border-radius: 10px;
    padding: 3rem 1.15rem 1.2rem;
    background:
      linear-gradient(180deg, rgba(17, 21, 29, 0.96), rgba(7, 10, 15, 0.98)),
      radial-gradient(circle at 88% 0%, rgba(199, 91, 58, 0.14), transparent 14rem) !important;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.88rem;
    line-height: 1.72;
    tab-size: 2;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
    scrollbar-color: rgba(200, 168, 107, 0.45) rgba(17, 21, 29, 0.8);
  }

  .content :global(pre)::before {
    content: "code";
    position: absolute;
    inset: 0 0 auto;
    height: 1.95rem;
    border-bottom: 1px solid rgba(27, 34, 48, 0.95);
    padding: 0.55rem 0.9rem 0;
    background: rgba(11, 14, 20, 0.72);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .content :global(pre)::after {
    content: "";
    position: absolute;
    top: 0.7rem;
    right: 0.9rem;
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow:
      -0.72rem 0 0 rgba(200, 168, 107, 0.82),
      -1.44rem 0 0 rgba(139, 191, 130, 0.72);
  }

  .content :global(pre code) {
    display: block;
    min-width: max-content;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .content :global(pre .line) {
    min-height: 1.72em;
  }

  .content :global(pre::-webkit-scrollbar) {
    height: 0.7rem;
  }

  .content :global(pre::-webkit-scrollbar-track) {
    background: rgba(17, 21, 29, 0.8);
  }

  .content :global(pre::-webkit-scrollbar-thumb) {
    border: 2px solid rgba(17, 21, 29, 0.8);
    border-radius: 999px;
    background: rgba(200, 168, 107, 0.5);
  }

  @media (max-width: 640px) {
    .post {
      padding-top: 2.5rem;
    }

    h1 {
      font-size: clamp(2.1rem, 10vw, 3.5rem);
    }

    .content :global(img) {
      max-height: 320px;
      margin: 1.25rem auto;
    }

    .content :global(iframe) {
      min-height: auto;
    }
  }
</style>
