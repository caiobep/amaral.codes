---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog-posts')

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await post.render()
const { title, date, tags, summary } = post.data
---

<Layout
  title={title}
  description={summary && summary !== 'undefined' ? summary : `A post by Caio Amaral about ${tags?.map((tag) => tag.name).join(', ') || 'software, ideas, and personal systems'}.`}
>
  <article class="post page-shell">
    <header>
      <a href="/posts" class="back-link">Back to posts</a>
      <time datetime={date}>{new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
      <h1>{title}</h1>
      {tags?.length ? (
        <ul>
          {tags.map((tag) => <li>{tag.icon} {tag.name}</li>)}
        </ul>
      ) : null}
    </header>

    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 760px;
    padding: 3.5rem 0 5rem;
  }

  header {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .back-link,
  time {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 750;
  }

  h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .content {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.72;
  }

  .content :global(p),
  .content :global(ul),
  .content :global(ol),
  .content :global(blockquote) {
    margin: 1rem 0;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    margin: 2rem 0 0.65rem;
    line-height: 1.12;
  }

  .content :global(h2) {
    font-family: var(--display);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .content :global(h3) {
    font-size: 1.32rem;
  }

  .content :global(a) {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .content :global(img) {
    width: auto;
    max-width: min(100%, 680px);
    max-height: 460px;
    height: auto;
    margin: 1.5rem auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    object-fit: contain;
    background: var(--paper-strong);
    box-shadow: 0 14px 40px rgba(36, 33, 29, 0.06);
  }

  .content :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .content :global(pre) {
    overflow-x: auto;
    border-radius: 8px;
    padding: 1.2rem;
    background: #201d19;
    color: #fffdf7;
  }

  @media (max-width: 640px) {
    .post {
      padding-top: 2.5rem;
    }

    h1 {
      font-size: clamp(2.1rem, 10vw, 3.5rem);
    }

    .content :global(img) {
      max-height: 320px;
      margin: 1.25rem auto;
    }

    .content :global(iframe) {
      min-height: auto;
    }
  }
</style>
