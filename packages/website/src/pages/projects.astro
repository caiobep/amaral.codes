---
import '../styles/pages/projects.css'
import '../styles/pages/project-controls.css'
import FeaturedProjectCase from '../components/FeaturedProjectCase.astro'
import PageIntro from '../components/PageIntro.astro'
import Layout from '../layouts/Layout.astro'
import { Search } from '@lucide/astro'
import {
  formatTechnologies,
  getProjectHref,
  getProjectIndex,
  isExternalProject,
} from '../lib/content'
import { createPageStructuredData } from '../lib/structured-data'

const {
  featuredProjects,
  otherSoftwareProjects,
  physicalProjects,
  projects,
} = await getProjectIndex()
const projectLabels = Array.from(new Set(
  projects.map((project) => project.data.category),
)).sort((left, right) => left.localeCompare(right, 'en'))
const labelFilters = [
  { label: 'All', value: 'all' },
  ...projectLabels.map((label) => ({
    label,
    value: label.toLocaleLowerCase('en'),
  })),
]
const pageDescription = 'Things Caio Amaral has made: macOS widgets, command-line tools, dotfiles, and experiments built to solve small problems or understand how something works.'
const structuredData = createPageStructuredData({
  description: pageDescription,
  pathname: Astro.url.pathname,
  title: 'Projects',
  type: 'CollectionPage',
}, Astro.site)
---

<Layout
  title="Projects"
  description={pageDescription}
  structuredData={structuredData}
>
  <PageIntro
    eyebrow="Projects"
    title="Things I’ve made."
    summary="Most began with a small annoyance, a missing tool, or something I wanted to understand."
  />

  <section class="project-index" aria-label="Find projects">
    <div class="project-controls page-shell" data-project-controls>
      <div class="project-index-title">
        <span>Project index</span>
        <strong>Find a project</strong>
      </div>
      <label class="project-search">
        <span class="control-label">Search</span>
        <span class="project-search-field">
          <Search aria-hidden="true" size={18} stroke-width={1.8} />
          <input
            type="search"
            id="search-projects"
            aria-label="Search projects"
            placeholder="Name, tool, or problem"
            autocomplete="off"
          />
        </span>
      </label>
      <fieldset class="project-filters">
        <legend>Labels</legend>
        <div>
          {labelFilters.map((filter) => (
            <button
              type="button"
              data-project-filter={filter.value}
              aria-pressed={filter.value === 'all' ? 'true' : 'false'}
            >
              <span>{filter.label}</span>
            </button>
          ))}
        </div>
      </fieldset>
    </div>
  </section>

  <div id="project-results">
    <section class="project-empty-state page-shell" hidden>
      <p class="section-label">No matches</p>
      <h2>Nothing matches that search.</h2>
      <span>Try another term, choose a different label, or clear the filters.</span>
      <button type="button" data-clear-project-search>Clear filters</button>
    </section>

    <section class="project-band" aria-label="Featured projects" data-project-group data-reveal>
      <div class="page-shell project-cases" data-stagger>
        {featuredProjects.map((project, index) => (
          <FeaturedProjectCase project={project} index={index} />
        ))}
      </div>
    </section>

    <section class="page-shell more-projects" aria-labelledby="more-projects-title" data-project-group data-reveal>
      <div class="more-projects-heading">
        <p class="section-label">Also made</p>
        <h2 id="more-projects-title">A few smaller experiments.</h2>
      </div>
      <div class="project-list" data-stagger>
        {otherSoftwareProjects.map((project) => {
          const external = isExternalProject(project)
          const searchText = [
            project.data.title,
            project.data.summary,
            project.data.category,
            ...project.data.technologies,
          ].join(' ')

          return (
            <a
              class="project-row"
              href={getProjectHref(project)}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              data-project
              data-project-label={project.data.category.toLocaleLowerCase('en')}
              data-project-search={searchText}
            >
              <div class="project-title">
                <span>{project.data.category}</span>
                <h3>{project.data.title}</h3>
              </div>
              <div class="project-copy">
                <p>{project.data.summary}</p>
                <strong>{formatTechnologies(project)}</strong>
              </div>
              <span class="project-arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
            </a>
          )
        })}
      </div>
    </section>

    {physicalProjects.length > 0 && (
      <section id="physical-projects" class="physical-projects" aria-labelledby="physical-projects-title" data-project-group data-reveal>
        <div class="page-shell physical-projects-inner">
          <div>
            <p class="section-label">Physical projects</p>
            <h2 id="physical-projects-title">Things that leave the screen.</h2>
          </div>
          <div class="physical-project-list">
            {physicalProjects.map((project) => {
              const external = isExternalProject(project)
              const searchText = [
                project.data.title,
                project.data.summary,
                project.data.category,
                ...project.data.technologies,
              ].join(' ')

              return (
                <a
                  href={getProjectHref(project)}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  data-project
                  data-project-label={project.data.category.toLocaleLowerCase('en')}
                  data-project-search={searchText}
                >
                  <span>{project.data.category}</span>
                  <h3>{project.data.title}</h3>
                  <p>{project.data.summary}</p>
                  <strong>{formatTechnologies(project)}</strong>
                </a>
              )
            })}
          </div>
        </div>
      </section>
    )}
  </div>

  <section class="page-shell cta" data-reveal>
    <div>
      <p class="section-label">The rest</p>
      <h2>There’s more on GitHub, in various states of done.</h2>
    </div>
    <a class="button-secondary" href="https://github.com/caiobep" target="_blank" rel="noopener noreferrer">Browse GitHub</a>
  </section>
</Layout>

<script>
  import '../scripts/project-filters'
</script>
