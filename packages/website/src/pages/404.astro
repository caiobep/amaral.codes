---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Path not found" description="The requested page could not be found on amaral.codes.">
  <section class="not-found page-shell">
    <p class="eyebrow">~/404</p>
    <h1>path not found<span aria-hidden="true">_</span></h1>
    <p>The archive has no file at this address.</p>
    <a class="button" href="/">Return home</a>
  </section>
</Layout>

<style>
  .not-found {
    display: grid;
    align-content: center;
    min-height: 100vh;
    padding: 5rem 0;
  }

  h1 {
    margin: 0.8rem 0 1rem;
    font-family: var(--mono);
    font-size: clamp(2.6rem, 7vw, 6rem);
    font-weight: 500;
    line-height: 1;
  }

  h1::before {
    color: var(--phosphor);
    content: "> ";
  }

  h1 span {
    color: var(--accent);
    animation: caret 1s steps(1) infinite;
  }

  p {
    max-width: 32rem;
    margin: 0 0 1.4rem;
    color: var(--muted);
  }

  a {
    justify-self: start;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
</style>
