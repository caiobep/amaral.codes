---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Path not found"
  description="The requested page could not be found on amaral.codes."
  robots="noindex,nofollow"
>
  <section class="not-found page-shell">
    <p class="eyebrow">Error 404</p>
    <h1>Nothing lives here.</h1>
    <p>The address may have changed, or the page may never have existed.</p>
    <a class="button" href="/">Return home</a>
    <p class="easter-egg"><strong>The cake is a lie.</strong></p>
  </section>
</Layout>

<style>
  .not-found {
    display: grid;
    align-content: center;
    min-height: 72vh;
    padding: 6rem 0;
  }

  h1 {
    margin: 0.8rem 0 1rem;
    font-family: var(--display);
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    font-weight: 400;
    line-height: 0.95;
  }

  p {
    max-width: 32rem;
    margin: 0 0 1.4rem;
    color: var(--muted);
  }

  a {
    justify-self: start;
  }

  .easter-egg {
    margin: 3.5rem 0 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    opacity: 0.5;
  }

</style>
