{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "amaral-codes",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "amaral.codes",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/posts/*"]
  }
}
